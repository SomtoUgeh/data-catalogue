# Live curation needs these three. Without them every create still saves,
# with empty tags, a placeholder summary, and curation_status=failed.
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_AI_GATEWAY_ID=your-ai-gateway-id
# Optional. Sent as cf-aig-authorization when the gateway itself requires auth.
CF_AI_GATEWAY_TOKEN=
# Cloudflare API token with Workers AI permission. Authorization: Bearer <token>
LLM_PROVIDER_API_KEY=
LLM_MODEL=workers-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Jev on Workers AI. Swap to @cf/cloudflare/clef-flash for the CF-hosted compatible model.
CLASSIFIER_MODEL=typesafe/jev
