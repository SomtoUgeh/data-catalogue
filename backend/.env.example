# Keyword mock is the default. A live LLM run also needs LLM_PROVIDER_API_KEY.
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_AI_GATEWAY_ID=your-ai-gateway-id
# Optional. Sent as cf-aig-authorization when the gateway itself requires auth.
CF_AI_GATEWAY_TOKEN=
# Cloudflare API token with Workers AI permission. Authorization: Bearer <token>
LLM_PROVIDER_API_KEY=
LLM_MODEL=workers-ai/@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Force the mock even if a key is present, or force a fallback demo.
# CURATOR=mock
# CURATOR=fail
