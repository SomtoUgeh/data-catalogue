{
  "name": "frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "generate-routes": "tsr generate",
    "gen:api": "python3 ../backend/scripts/export_openapi.py > openapi.json && openapi-ts",
